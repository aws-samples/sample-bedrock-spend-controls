// Data flow diagram for the Bedrock Spend Controls threat model.
// Dashed regions are trust zones; every arrow that crosses a dashed line is a
// trust-boundary crossing and carries the DF-n / B-n identifiers used in
// docs/threat-model.md.  Render with:  dot -Tpng assets/data-flow.dot -o assets/data-flow.png
// tools/render_data_flow.py regenerates the PNG and the "Data flow (trust boundaries)"
// page of assets/architecture.drawio from this file.
digraph DFD {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, compound=true, nodesep=0.3, ranksep=0.7, pad=0.3, splines=true, newrank=true, labelloc=t,
         label="Bedrock Spend Controls — data flow diagram (DF-n = data flow, B-n = trust boundary crossing)"];
  node  [shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#4b5563", fontname="Helvetica", fontsize=10, margin="0.15,0.08"];
  edge  [fontname="Helvetica", fontsize=8, color="#374151", fontcolor="#1f2937", arrowsize=0.7];

  subgraph cluster_outside {
    label="Outside the AWS account"; style="dashed,rounded"; color="#9ca3af"; fontcolor="#374151";
    user     [label="End user", shape=ellipse, fillcolor="#fff7ed"];
    app      [label="Application backend\n(customer code, SigV4 caller)", fillcolor="#fff7ed"];
    idp      [label="Identity provider\nCognito or corporate OIDC", fillcolor="#fff7ed"];
    admin    [label="Administrator\nbrowser / CLI", shape=ellipse, fillcolor="#fff7ed"];
    operator [label="Operator with\naccount privileges", shape=ellipse, fillcolor="#fff7ed"];
    alert    [label="Alert endpoint\n(alert_email)", fillcolor="#fff7ed"];
  }

  subgraph cluster_stack {
    label="Bedrock Spend Controls stack (this sample)"; style="dashed,rounded"; color="#2563eb"; fontcolor="#1e3a8a";

    subgraph cluster_vend {
      label="Vend + admin"; style="dashed,rounded"; color="#93c5fd"; fontcolor="#1e40af";
      ui      [label="Admin UI\nS3 + CloudFront (static)"];
      broker  [label="Broker / admin Lambda\nJWT verify · quota · lease · STS vend · admin API", fillcolor="#dbeafe"];
      users   [label="Users table\nlimits · status · leases\nSESSION# · REVOCATION# · CONFIG#", shape=cylinder, fillcolor="#e0f2fe"];
      audit   [label="Admin audit table", shape=cylinder, fillcolor="#e0f2fe"];
      secrets [label="Secrets Manager\nadmin key · break-glass key", shape=cylinder, fillcolor="#e0f2fe"];
      ssm     [label="SSM parameters\nprice snapshot · workload roster", shape=cylinder, fillcolor="#e0f2fe"];
    }

    subgraph cluster_meter {
      label="Metering"; style="dashed,rounded"; color="#93c5fd"; fontcolor="#1e40af";
      processor [label="Usage processor Lambda\nprice · dedupe · counters · block", fillcolor="#dbeafe"];
      usage     [label="Usage table\nledger · RATE# · REQUEST# · RECONCILE#", shape=cylinder, fillcolor="#e0f2fe"];
      cw        [label="CloudWatch metrics + alarms\nSNS topic"];
      recon     [label="Spend reconciliation Lambda\n(opt-in, daily)", fillcolor="#dbeafe"];
    }

    subgraph cluster_enforce {
      label="Enforcement"; style="dashed,rounded"; color="#93c5fd"; fontcolor="#1e40af";
      enforcers [label="Enforcement processors\ndispatcher · revocation · emergency", fillcolor="#dbeafe"];
      wenf      [label="Workload enforcer\n(5-minute schedule)", fillcolor="#dbeafe"];
      sweeper   [label="Auto-block sweeper\n(nightly 00:05 UTC)", fillcolor="#dbeafe"];
    }
  }

  subgraph cluster_aws {
    label="AWS services in the account"; style="dashed,rounded"; color="#d97706"; fontcolor="#92400e";
    sts     [label="AWS STS", fillcolor="#fef3c7"];
    iam     [label="IAM\nBedrockUserRole · boundary\ndeny policies · workload roles", fillcolor="#fef3c7"];
    bedrock [label="Amazon Bedrock Runtime", fillcolor="#fef3c7"];
    logs    [label="Model invocation log group\n(payload delivery off)", shape=cylinder, fillcolor="#fef3c7"];
    ce      [label="AWS Cost Explorer", fillcolor="#fef3c7"];
    cfn     [label="CloudFormation / CDK", fillcolor="#fef3c7"];
  }

  // Identity and vend
  user   -> idp       [label="DF-1"];
  idp    -> app       [style=dotted, arrowhead=none];  // the user JWT reaches the application
  app    -> broker    [label="DF-2 · B1", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  broker -> idp       [label="DF-3", style=dashed];
  broker -> users     [label="DF-4", dir=both];
  broker -> sts       [label="DF-5 · B2", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  sts    -> iam       [style=dashed, arrowhead=none];  // session is bounded by role + boundary
  broker -> app       [style=dashed];  // vended credentials + quota headers (return leg of DF-2)

  // Inference and metering
  app       -> bedrock   [label="DF-6 · B3", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  bedrock   -> logs      [label="DF-7"];
  logs      -> processor [label="DF-8 · B4", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  ssm       -> processor [label="prices", style=dashed];
  processor -> usage     [label="DF-9"];
  processor -> users     [label="DF-9"];
  processor -> cw        [label="DF-9"];
  cw        -> alert     [label="DF-19"];

  // Enforcement
  users     -> enforcers [label="DF-10 · B5", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  enforcers -> iam       [label="CreatePolicyVersion"];
  usage     -> wenf      [label="DF-11"];
  wenf      -> iam       [label="DF-11 · B5", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  sweeper   -> users     [label="DF-12"];
  usage     -> sweeper   [label="DF-12", style=dashed];

  // Administration
  admin  -> ui      [label="DF-13", style=dashed];
  ui     -> broker  [label="DF-13 · B6", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  admin  -> broker  [label="DF-14 · B6", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  broker -> audit   [label="DF-15"];
  broker -> cw      [label="DF-16", style=dashed];
  broker -> ssm     [label="DF-16", style=dashed];
  secrets -> broker [label="DF-16", style=dashed];

  // Reconciliation and deployment
  recon    -> ce    [label="DF-17 · B7", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  recon    -> usage [label="DF-17", dir=both];
  operator -> cfn   [label="DF-18 · B7", penwidth=1.6, color="#b91c1c", fontcolor="#b91c1c"];
  cfn      -> iam   [style=dashed];  // roles, boundary, policies (DF-18)
  cfn      -> logs  [style=dashed];  // logging configuration (DF-18)
  cfn      -> ssm   [style=dashed];  // price snapshot + roster (DF-18)
}
